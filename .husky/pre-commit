staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^frontend/'; then
  pnpm --dir frontend exec lint-staged --relative --max-arg-length 3000 --concurrent 2 || exit 1
fi

if echo "$staged" | grep -q '^backend/'; then
  pnpm --dir backend exec lint-staged --relative --max-arg-length 3000 --concurrent 2 || exit 1
fi
